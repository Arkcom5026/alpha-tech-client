{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "buildCommand": "npm run build && node scripts/generate-release-metadata.mjs",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
